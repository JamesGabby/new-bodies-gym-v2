// public/site.webmanifest
{
  "name": "New Bodies Gym",
  "short_name": "New Bodies",
  "description": "Where everyone is welcome",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#ADFF2F",
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}